# ============================================================
# Vitis / host tooling .gitignore
#
# What belongs in this repository: the bare-metal firmware sources,
# the host engine and GUI, the verification scripts and models, and
# the documentation. Everything Vitis generates from the .xsa, every
# build product, and every multi-hundred-megabyte data file is
# excluded.
# ============================================================

# --- Generated Vitis platform -------------------------------
# mlp_platform/ is the board-support package Vitis generates from
# mlp_system_wrapper.xsa. It is roughly 5,700 files of lwIP and
# Xilinx driver source that belong to the tool, not to this project.
# Recreate it with: Vitis -> Create Platform Component -> select the
# .xsa in this directory. See README.md.
mlp_platform/

# --- Vitis / Vivado scratch ---------------------------------
.Xil/
.rigel_lopper/
_ide/
.vitisWorkspace.json
*.lock
*.log
*.jou
*.str
vivado.log
vivado.jou

# --- Firmware build products --------------------------------
lwip_echo_server/build/
lwip_echo_server/Debug/
lwip_echo_server/Release/
lwip_echo_server/_ide/
lwip_echo_server/BOOT.bin
lwip_echo_server/*.xsa
*.o
*.obj
*.d
*.a
*.elf
*.elf.size
*.bit
*.pdi
*.exe

# --- BOOT.bin ----------------------------------------------
# Regenerated by bootgen from the .elf and the bitstream.
BOOT.bin

# --- clangd / IDE caches -----------------------------------
**/.cache/
**/compile_commands.json
.clangd
.vscode/
.settings/
.metadata/
.analytics/
.idea/

# --- Python ------------------------------------------------
__pycache__/
*.pyc
pc_test/.venv/
.venv/
venv/

# --- Large derived data ------------------------------------
# Multi-hundred-megabyte intermediates. The converted market CSVs
# are produced by data_prep_binance.py from the Binance archive;
# verify_stream.csv is produced deterministically by
# make_verify_stream.py at a fixed seed. Neither is kept here.
*.parquet
pc_test/BTCUSDT_*.csv
pc_test/temp_*.csv
pc_test/temp_weights.bin
pc_test/execution_log.csv
pc_test/verify/verify_stream.csv
pc_test/linux/log_*.csv
pc_test/linux/*.csv

# --- Measurement logs --------------------------------------
# The raw logs behind the latency tables are kept in compressed form.
# Only the two logs that a table in the paper is computed from are
# tracked; the rest are either exact duplicates, derived files that
# parse_stage_timing.py reproduces, or runs superseded by the
# corrected bitstream.
pc_test/_archive_pre_verify/*.csv
pc_test/_archive_pre_verify/**/*.csv
pc_test/_archive_pre_verify/*.gz
pc_test/_archive_pre_verify/**/*.gz
!pc_test/_archive_pre_verify/2026-07-12_1M-paket_TABLO10-KAYNAGI.csv.gz
!pc_test/_archive_pre_verify/2026-05-30_rastgele-model-rastgele-veri.csv.gz

# --- Host binaries -----------------------------------------
pc_test/hft_engine.exe
pc_test/linux/hft_engine_linux
pc_test/test_mlp_linux

# --- Editor / OS -------------------------------------------
*.swp
*~
Thumbs.db
.DS_Store

# --- Tooling ------------------------------------------------
.claude/

# --- Hardware handoff --------------------------------------
# The top-level .xsa is kept: it is what the Vitis platform is
# generated from, and keeping it means the firmware can be rebuilt
# without running Vivado. Nested copies are not.
*.xsa
!/mlp_system_wrapper.xsa
